<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; margin: 0; padding: 0; background-color: #f4f4f4; }
        .container { max-width: 600px; margin: 20px auto; background-color: #ffffff; border: 1px solid #dddddd; border-radius: 8px; overflow: hidden; }
        .header { background-color: {{ state_color }}; color: #ffffff; padding: 20px; text-align: center; }
        .header h1 { margin: 0; font-size: 24px; }
        .content { padding: 20px; }
        .details-table { width: 100%; border-collapse: collapse; }
        .details-table th, .details-table td { padding: 12px 15px; border-bottom: 1px solid #eeeeee; text-align: left; }
        .details-table th { background-color: #f9f9f9; font-weight: 600; color: #333333; width: 30%; }
        .details-table td { color: #555555; }
        .action-button { display: inline-block; padding: 10px 20px; margin-top: 20px; font-weight: 600; color: #ffffff; background-color: #007bff; text-decoration: none; border-radius: 5px; border: 1px solid #007bff; transition: background-color 0.2s ease-in-out, border-color 0.2s ease-in-out; }
        /* Basic hover effect for email clients that support it */
        .action-button:hover { background-color: #0056b3; border-color: #0056b3; }
        .output-box { background-color: #f0f0f0; border: 1px solid #e0e0e0; padding: 15px; border-radius: 5px; font-family: "Courier New", Courier, monospace; white-space: pre-wrap; word-wrap: break-word; }
        .footer { padding: 20px; text-align: center; font-size: 12px; color: #888888; background-color: #f4f4f4; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>{{ notification_type }}</h1>
        </div>
        <div class="content">
            <table class="details-table">
                {% if service_desc %}
                <tr><th>{{ t.service or 'Service' }}</th><td>{{ service_desc or object_name }}</td></tr>
                <tr><th>{{ t.host or 'Host' }}</th><td>{{ host_name }}</td></tr>
                {% else %}
                <tr><th>{{ t.host or 'Host' }}</th><td>{{ host_name or object_name }}</td></tr>
                {% endif %}
                <tr><th>{{ t.state }}</th><td style="color: {{ state_color }}; font-weight: bold;">{{ state }}</td></tr>
                {% if notes %}
                <tr><th>{{ t.notes }}</th><td>{{ notes }}</td></tr>
                {% endif %}
            </table>
            <h3 style="border-bottom: 2px solid #eeeeee; padding-bottom: 5px; margin-top: 30px;">{{ t.plugin_output }}</h3>
            <div class="output-box">{{ output }}</div>
            {% if author and comment %}
            <h3 style="border-bottom: 2px solid #eeeeee; padding-bottom: 5px; margin-top: 30px;">{{ t.notification_comment }}</h3>
            <p><b>{{ t.author }}:</b> {{ author }}<br><b>{{ t.comment }}:</b> {{ comment }}</p>
            {% endif %}
            {% if icingaweb2_url %}
            <div style="text-align: center;">
                <a href="{{ icingaweb2_url }}" class="action-button">View in Icinga</a>
            </div>
            {% endif %}
        </div>
        <div class="footer">
            Automated notification from Icinga 2
        </div>
    </div>
</body>
</html>